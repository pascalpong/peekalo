SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SHARE_TOKEN_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
# Product web/API origin used by shared links and private delivery.
PUBLIC_APP_URL=https://YOUR_VIEWER_HOST
# Marketing website origin for About/privacy links and the waitlist proxy.
# Omit to hide website links in production; development defaults to port 3100.
# PUBLIC_SITE_URL=https://YOUR_MARKETING_HOST
# Open only after the waitlist migration and a working privacy contact/removal route.
WAITLIST_ENABLED=false
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# D-25: the server enforces three active moments per account; no quota override.
# Optional native auth domain associations; omitted/invalid values return 404.
# AUTH_LINK_ORIGIN must equal PUBLIC_APP_URL and the mobile build's
# EXPO_PUBLIC_AUTH_LINK_ORIGIN. Use real signing IDs, never placeholder IDs.
# AUTH_LINK_ORIGIN=https://app.your-domain.example
# APPLE_APP_ID=YOUR_TEAM_ID.your.registered.bundle.id
# ANDROID_APP_ID=your.registered.package.id
# Comma-separated public SHA-256 certificate fingerprints (32 colon-separated
# bytes each); use the Play app-signing certificate for Play-distributed builds.
# ANDROID_SHA256_CERT_FINGERPRINTS=YOUR_PUBLIC_SHA256_CERT_FINGERPRINT

# Optional PUBLIC operational details, set only after the human supplies real
# monitored mailboxes and an agreed age/audience policy. Missing values are shown
# honestly as a closed-beta release gate. Never put operator credentials here.
# SAFETY_SUPPORT_EMAIL=
# SAFETY_CHILD_SAFETY_EMAIL=
# SAFETY_AGE_POLICY=

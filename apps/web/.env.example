SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SHARE_TOKEN_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
# Product web/API origin used by shared links and private delivery.
PUBLIC_APP_URL=https://YOUR_VIEWER_HOST
# Marketing website origin for About/privacy links and the waitlist proxy.
# Omit to hide website links in production; development defaults to port 3100.
# PUBLIC_SITE_URL=https://YOUR_MARKETING_HOST
# Open only after the waitlist migration and a working privacy contact/removal route.
WAITLIST_ENABLED=false
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Only set a post quota after the provisional product limit is confirmed.
# PEEKALO_ACTIVE_POST_LIMIT=3

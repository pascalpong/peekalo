# Public origins only; no paths, credentials or query strings.
# These loopback values are for local development. Set both actual HTTPS origins when deployed.
# If omitted entirely, development alone defaults to these origins; production has no fallback.
PUBLIC_SITE_URL=http://127.0.0.1:3100
PUBLIC_APP_URL=http://127.0.0.1:3101
# Keep closed until backend storage, contact/removal and consent checks pass.
WAITLIST_ENABLED=false

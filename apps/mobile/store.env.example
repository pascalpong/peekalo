# Public build inputs only; deliberately unusable until confirmed by the owner.
# Copy to ignored .cache/release/store.env. Never change the active .env.local.
# These values must be the registered store identities and matching deployed
# production product origin, not the current development backend.
PEEKALO_BUILD_PROFILE=store
EXPO_NO_DOTENV=1
PEEKALO_IOS_BUNDLE_ID=
PEEKALO_ANDROID_PACKAGE=
PEEKALO_RELEASE_VERSION=
PEEKALO_IOS_BUILD_NUMBER=
PEEKALO_ANDROID_VERSION_CODE=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_AUTH_LINK_ORIGIN=

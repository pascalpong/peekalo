{
  "name": "peekalo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.14.1 <25",
    "pnpm": ">=11.25.0 <12"
  },
  "scripts": {
    "dev:web": "pnpm --filter @peekalo/web dev",
    "dev:mobile": "pnpm --filter @peekalo/mobile start",
    "ios": "node scripts/run-native.mjs ios",
    "android": "node scripts/run-native.mjs android",
    "lint": "pnpm -r lint && eslint scripts",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm build:site && pnpm build:web",
    "export:mobile": "pnpm --filter @peekalo/mobile export",
    "test:mobile": "pnpm --filter @peekalo/mobile test",
    "check": "pnpm lint && pnpm typecheck && pnpm test:mobile && pnpm test:reveal && pnpm test:backend && pnpm test:hosting && pnpm test:uploads && pnpm test:delivery && pnpm test:waitlist && pnpm test:web-split && pnpm brand:check && pnpm build && pnpm export:mobile",
    "test:hosting": "node --test scripts/test-hosting-runtime.mjs",
    "brand:generate": "node scripts/generate-brand.mjs",
    "brand:check": "node scripts/generate-brand.mjs --check",
    "test:waitlist": "node --test scripts/test-waitlist.mjs",
    "test:reveal": "pnpm --filter @peekalo/reveal test && node --test scripts/test-protected-viewer.mjs scripts/test-fullscreen-reveal.mjs",
    "test:sharing": "node --env-file=apps/web/.env.local scripts/test-sharing-backend.mjs",
    "test:backend": "node --test scripts/test-backend-ledger.mjs",
    "dev:site": "pnpm --filter @peekalo/site dev",
    "build:site": "pnpm --filter @peekalo/site build",
    "build:web": "pnpm --filter @peekalo/web build",
    "test:web-split": "node --test scripts/test-web-split.mjs",
    "test:uploads": "node --test scripts/test-upload-admission.mjs scripts/test-upload-ledger.mjs scripts/test-upload-handler.mjs scripts/test-backend-fetch.mjs",
    "test:delivery": "node --test scripts/test-private-media-cache.mjs scripts/test-media-delivery.mjs",
    "local:setup": "node scripts/dev-local-backend.mjs",
    "local:stop": "node scripts/dev-local-backend.mjs stop",
    "dev:web:local": "node scripts/dev-local-apps.mjs web",
    "dev:mobile:local": "node scripts/dev-local-apps.mjs mobile",
    "test:auth:local": "node --env-file=apps/web/.env.local-testing scripts/test-local-auth.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "embedded-postgres": "15.18.0-beta.17",
    "eslint": "10.12.0",
    "pg": "8.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
